# Sao chép thành infra/.env rồi điền giá trị cho máy của bạn.
# infra/.env đã bị .gitignore chặn — KHÔNG BAO GIỜ commit file đó.

# ---- PostgreSQL ----
POSTGRES_USER=powerme
POSTGRES_PASSWORD=powerme
POSTGRES_DB=powerme
POSTGRES_PORT=5432
DATABASE_URL=postgresql://powerme:powerme@localhost:5432/powerme

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- CSMS ----
CSMS_HTTP_PORT=3000
CSMS_OCPP_WS_PORT=3001
# Đường dẫn WebSocket định danh trụ theo SN: ws://host:3001/ocpp/<serialNumber>
CSMS_OCPP_PATH_PREFIX=/ocpp

# Cổng gateway OCPP của apps/csms (Iteration 1). Ưu tiên hơn CSMS_OCPP_WS_PORT; 9000 khớp
# cấu hình simulator của lab (ws://localhost:9000/ocpp). Thống nhất một tên khi dựng staging.
OCPP_PORT=9000

# Heartbeat: quá ngưỡng này mà không thấy trụ thì sinh cảnh báo mất kết nối
OCPP_HEARTBEAT_INTERVAL_SECONDS=300
OCPP_OFFLINE_THRESHOLD_SECONDS=900

# ---- Engine đối soát (BE-07, docs/ITERATION-1-WF03.md) ----
# MeterValueSampleInterval của trụ (SAP template powerme-d1: 10 s)
METER_VALUE_SAMPLE_INTERVAL_S=10
# Khoảng cách hai mẫu > hệ số này × sample interval là lỗ hổng chuỗi
RECONCILE_GAP_FACTOR=3
# Dung sai Wh khi so meterStop với mẫu MeterValues cuối (bù làm tròn Wh thập phân)
RECONCILE_ENERGY_TOLERANCE_WH=1
# Công tắc ablation (G6): false = KHÔNG đối soát — tin meterStop của trụ (phiên closed -> reconciled
# thẳng, energy = meterStop - meterStart) và không ghi reconciliation_records. Chỉ dùng cho thí
# nghiệm so bật/tắt; mặc định true. Chi tiết: docs/ITERATION-1-WF03.md mục 9.
RECONCILIATION_ENABLED=true

# ---- State machine phiên sạc (T13 — XAC-NHAN-STATE-MACHINE-T13.md mục 1.3) ----
# Là biến môi trường, KHÔNG phải bảng cấu hình trong DB.
# pending quá ngưỡng này mà chưa thấy StartTransaction thì phiên chuyển failed
SESSION_START_TIMEOUT_S=120
# Phiên active quá ngưỡng này thì CSMS tự dừng và đưa vào review
SESSION_HARD_CAP_H=24
# |cp_timestamp - received_at| vượt ngưỡng này là ứng viên phát lại (ADR-0009)
REPLAY_SKEW_THRESHOLD_S=5
TARIFF_CLOCK_TOLERANCE_S=300

# ---- Xác thực ----
JWT_SECRET=doi-gia-tri-nay-truoc-khi-chay
JWT_EXPIRES_IN=1d

# MB03 Driver API: HS256, max 15 minutes; separate from legacy unused JWT_* above.
# Supply a base64 encoding of >=32 cryptographically random bytes, never a password.
DRIVER_API_JWT_SECRET_BASE64=
DRIVER_API_JWT_ISSUER=
DRIVER_API_JWT_AUDIENCE=
# BE-21: refresh token life in seconds (3600..7776000). Empty = 2592000 (30 days).
DRIVER_API_REFRESH_TTL_S=
DRIVER_API_DEV_AUTH=false
# FE-01a / ADR-0018: Operator Dashboard + Admin Console login (POST /api/auth/v1/login), HS256, 8 h.
# Its own key: never reuse the DRIVER_API key. Base64 of >=32 random bytes (openssl rand -base64 32).
# All three or none; empty = /api/{auth,operator,admin}/v1 answer 503 auth_unavailable.
DASHBOARD_JWT_SECRET_BASE64=
DASHBOARD_JWT_ISSUER=
DASHBOARD_JWT_AUDIENCE=
# Dev header additionally requires NODE_ENV=development + local (or test + test).
DRIVER_API_ENV=
# Backend only. Independent of the mobile Tile key; rights must be verified per API.
VIETMAP_SEARCH_API_KEY=
SMART_SEARCH_RANGE_FACTOR=0.75
SMART_SEARCH_ROAD_FACTOR=1.3
SMART_SEARCH_RESERVE_KM=10
SMART_SEARCH_AVG_SPEED_KMH=30
SMART_SEARCH_CHARGE_EFFICIENCY=0.85
SMART_SEARCH_AVAILABLE_WAIT_MIN=0
SMART_SEARCH_FREEING_SOON_WAIT_MIN=5
SMART_SEARCH_IN_USE_WAIT_MIN=30
SMART_SEARCH_RADIUS_FACTOR=1.5
SMART_SEARCH_FALLBACK_LIMIT=3

# ---- SteVe (CSMS đối chứng, profile "reference") ----
STEVE_DB_PASSWORD=changeme
STEVE_HTTP_PORT=8180
STEVE_WS_PORT=8181

# ---- VNPay sandbox (QA-04) ----
# Xin trước, đừng đợi tới S5. Nếu không xin được thì chuyển sang mock service.
# WF-02 (T32 Phần 5): thiếu TMN_CODE hoặc HASH_SECRET → tạo top-up trả 503 payment_unconfigured.
# KHÔNG ghi mã thật vào repo; đặt trong .env của máy / staging.
# VNPAY_RETURN_URL: trang return /billing/vnpay/return (D8, T32 Phần 6) — chỉ hiển thị, không ghi DB;
#   staging: https://<DOMAIN>/billing/vnpay/return.
# URL IPN (không phải biến môi trường): khai trên cổng merchant VNPay là
#   https://<DOMAIN>/billing/vnpay/ipn (công khai, chỉ dựa chữ ký; Caddy staging mở đúng đường này).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/billing/vnpay/return
# T32 Phần 8 (D4): querydr của vòng quét top-up quá hạn (POST JSON, gọi ra ngoài, timeout 10 s).
# VNPAY_API_URL trống = sandbox. VNPAY_SERVER_IP = vnp_IpAddr của querydr ("IP máy chủ gọi API"),
#   phải là địa chỉ IP; trống = 127.0.0.1 (nếu VNPay kiểm IP thì điền IP ra ngoài của máy chủ).
# Thiếu TMN_CODE / HASH_SECRET → vòng quét không giữ chỗ dòng nào, top-up pending giữ nguyên.
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=

# Cho trụ chưa có credential (seed trước WF-05) kết nối không cần Basic auth. Mặc định false.
# CHỈ bật cho demo/lab; không bật trên staging/production. `npm run demo` tự đặt true.
ALLOW_LEGACY_NO_CREDENTIAL=false

# WF-05 (T119): user ids the console acts as for the two onboarding routes
# (POST /api/admin/charge-points = Admin, POST /api/operator/charge-points/onboard = operator staff).
# No default: unset → that route answers 503 actor_not_configured. The service still checks the role
# of these users. `npm run demo` sets them from demo/seed.sql. Replaced by RolesGuard (T103).
CONSOLE_ACTOR_ADMIN_ID=
CONSOLE_ACTOR_STAFF_ID=

# CSMS đứng sau reverse proxy (Caddy): bộ giới hạn đăng nhập sai của trụ (#40) lấy IP từ giá trị
# cuối của X-Forwarded-For. Chỉ bật khi có proxy phía trước; staging đặt true trong compose.
OCPP_TRUST_PROXY=false

# ADR-0016 D-A / STM-1 v0.5: thời gian ân hạn (giây) từ lúc socket đóng tới khi phiên active/paused/
# stopping bị chuyển orphaned. Trụ nối lại trong ân hạn thì phiên giữ nguyên trạng thái.
# 0 = orphan ngay khi socket đóng (hành vi cũ). Số nguyên >= 0. 120 do WP1 chốt ngày 26/10 (ADR-0016).
# `npm run demo` đặt 20 để kịch bản rớt mạng 60 s vẫn thấy orphaned rồi active.
OFFLINE_GRACE_S=120

# WP3/T72 charging service: configurable proposal values; MB03 exposes read-only discovery.
CHARGE_MINIMUM_START_VND=50000
CHARGE_CUTOFF_RESERVE_VND=10000
CHARGE_POINTS_EXPIRY_MONTHS=12
CHARGE_COMMAND_TIMEOUT_MS=30000
CHARGE_STATION_STALE_MS=600000

# WF-02 D7 (T32 Phần 12): worker quét DB của billing (refund, e-invoice, timeout top-up).
# ENABLED=false tắt cả vòng quét lẫn kick. INTERVAL_MS 1000–3600000. BATCH_SIZE 1–100.
# LEASE_MS ≥ 30000: thời gian giữ chỗ một dòng trong lúc gọi VNPay / nhà cung cấp hoá đơn.
BILLING_WORKER_ENABLED=true
BILLING_WORKER_INTERVAL_MS=30000
BILLING_WORKER_BATCH_SIZE=20
BILLING_WORKER_LEASE_MS=120000

# WF-04 / STM-6 t6 (FE-04): hạn chờ (giây) sau khi operator gửi Reset từ xa cho một sự cố. Hết hạn
# mà súng chưa báo Available thì sự cố quay về `acknowledged`, lệnh remote_commands thành `timeout`.
# Số nguyên > 0. 120 = trụ khởi động lại + Boot + StatusNotification (WF-04 câu hỏi mở 3).
FAULT_RESET_TIMEOUT_S=120

# G10 / NFR-OCPP-07 (FE-10): trụ in_service im lặng quá OFFLINE_ALERT_S giây (không frame nào) thì
# mở một FaultEvent "Offline" cho cả trụ; trụ nói lại thì sự cố tự đóng. Quét mỗi
# OFFLINE_ALERT_SWEEP_S giây. Cả hai là số nguyên > 0. Khác OFFLINE_GRACE_S (chỉ cho phiên orphan).
OFFLINE_ALERT_S=900
OFFLINE_ALERT_SWEEP_S=60
