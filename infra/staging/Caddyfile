# TLS cho mọi thứ (OCPP Security Profile 2 cần wss). Let's Encrypt tự cấp cho $DOMAIN
# (cần DNS A record trỏ về VPS và cổng 80/443 mở).
#
# CHỈ các đường dẫn dưới đây ra internet: /ocpp/*, /health, đúng hai đường VNPay
# /billing/vnpay/ipn, /billing/vnpay/return (T32 Phần 6, Trí duyệt), Driver API /api/driver/v1/*
# (BE-45, có JWT tài xế), Operator/Admin API /api/{auth,operator,admin}/v1/* (BE-46, JWT dashboard) và
# trang dashboard (BE-46, file tĩnh) ở mọi đường còn lại. Console vận hành (/api/admin/*,
# gồm POST ngắt kết nối và RemoteStop) CHƯA có xác thực nên TUYỆT ĐỐI không được proxy ở đây — xem
# bằng SSH tunnel. KHÔNG mở /billing/* hay đường console khác. Khi có xác thực (users + RolesGuard)
# và REST/realtime cho app thì mới thêm route.
{$DOMAIN} {
	encode gzip

	# OCPP-J 1.6: wss://DOMAIN/ocpp/{serialNumber}. Basic Auth do CSMS kiểm lúc nâng cấp WebSocket;
	# TLS kết thúc ở đây nên mật khẩu không đi trần trên internet. Caddy tự xử lý Upgrade.
	handle /ocpp/* {
		reverse_proxy csms:9000
	}

	# Chỉ đúng đường dẫn /health (khớp tuyệt đối) của console: {"ok":true,"db":true} hoặc 503.
	# Không lộ phiên bản hay chi tiết. Cho giám sát bên ngoài; phần còn lại của console không ra.
	handle /health {
		reverse_proxy csms:3000
	}

	# WF-02 D8 (T32 Phần 6): VNPay gọi IPN server-to-server (chỉ dựa chữ ký, CSMS kiểm); return là
	# trang tĩnh trình duyệt tài xế quay về. Khớp ĐÚNG hai đường dẫn (query không ảnh hưởng khớp).
	handle /billing/vnpay/ipn {
		reverse_proxy csms:3000
	}
	handle /billing/vnpay/return {
		reverse_proxy csms:3000
	}

	# BE-45 / BE-46: các API CÓ JWT (ADR-0018) ra internet — Driver API cho app tài xế, và
	# auth/operator/admin v1 cho dashboard. CSMS chuyển /api/driver/ sang listener Driver API và
	# /api/{auth,operator,admin}/v1 sang Operator API (RolesGuard) TRƯỚC console, nên không rơi vào
	# console chưa xác thực. Caddy khớp path không phân biệt hoa/thường và sau khi chuẩn hoá, còn
	# CSMS khớp URI gốc phân biệt hoa/thường — nên chặn 400 trước khi proxy khi URI gốc:
	#   - chứa "..", %2e, %2f hoặc %5c (đường vòng), hoặc
	#   - không bắt đầu ĐÚNG chữ thường /api/<driver|auth|operator|admin>/v1/, hoặc có "%" trong path
	#     (vd. /API/driver/v1/x, /%61pi/admin/v1/x — CSMS sẽ không coi là API mà đưa vào console).
	# Chuỗi raw r'…' của CEL: regex không qua lớp escape nào (chuỗi "…" thường làm CEL lỗi lúc chạy).
	@api path /api/driver/v1/* /api/auth/v1/* /api/operator/v1/* /api/admin/v1/*
	handle @api {
		@unsafe expression `{http.request.orig_uri}.matches(r'(?i)(\.\.|%2e|%2f|%5c)') || !{http.request.orig_uri}.matches(r'^/api/(driver|auth|operator|admin)/v1/[^%?#]*(\?|$)')`
		respond @unsafe 400
		reverse_proxy csms:3000
	}

	# Mọi /api… khác (gồm console /api/admin/* chưa xác thực): 404 ngay tại Caddy, không tới CSMS.
	# KHÔNG đổi thành proxy cả /api.
	handle /api* {
		respond 404
	}

	# BE-46: dashboard vận hành (React SPA, image powerme-dashboard). Mọi đường còn lại.
	handle {
		reverse_proxy dashboard:8080
	}
}
