# Sao chép thành infra/staging/.env TRÊN VPS rồi điền. .env bị .gitignore chặn — KHÔNG commit.
# deploy.sh từ chối chạy nếu còn giá trị mẫu (chuỗi "change-me" hoặc tên miền ví dụ).
# Quy tắc giá trị: không có khoảng trắng, nháy, $ hay # (file được compose đọc và deploy.sh đọc
# theo hai cách khác nhau; ký tự lạ làm lệch).

# ---- Máy chủ ----
# Tên miền đã trỏ A record về VPS (Let's Encrypt cần).
DOMAIN=staging.example.com
# Registry + chủ sở hữu, viết thường. Image: $REGISTRY/powerme-csms:$TAG, $REGISTRY/powerme-simulator:$TAG
REGISTRY=ghcr.io/powermeapp
# deploy.sh / rollback.sh tự ghi dòng này. Đừng sửa tay khi stack đang chạy.
TAG=review-2

# ---- PostgreSQL ----
POSTGRES_USER=powerme
POSTGRES_DB=powerme
# >= 16 ký tự, chỉ chữ/số và . _ ~ - (vì nằm trong DATABASE_URL). Sinh bằng: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ---- Trụ demo (chỉ cần khi seed hoặc chạy simulator) ----
# Mật khẩu Basic Auth của trụ RH24D1-00001, >= 16 ký tự. seed-demo.mjs băm (scrypt) rồi ghi vào DB;
# simulator gửi chính chuỗi này. Để trống nếu không seed và không chạy simulator.
# Sinh bằng: openssl rand -base64 24. `.env` cũ dùng tên DEMO_PILLAR_PASSWORD vẫn chạy (đọc khi tên mới trống).
DEMO_CHARGE_POINT_PASSWORD=

# ---- Driver API cho app tài xế (BE-27) ----
# ./init-env.sh tự sinh ba biến này; .env cũ thì chạy ./init-env.sh --add-missing (không đổi mật khẩu cũ).
# Đặt đủ cả ba hoặc để trống cả ba (trống: /api/driver trả 503 auth_unavailable, deploy chỉ cảnh báo).
# Khoá HS256: base64 CHUẨN (có dấu = đệm) của >= 32 byte ngẫu nhiên. Sinh bằng: openssl rand -base64 32
# Đổi khoá = mọi token app đang giữ mất hiệu lực (tài xế đăng nhập lại).
DRIVER_API_JWT_SECRET_BASE64=
DRIVER_API_JWT_ISSUER=
DRIVER_API_JWT_AUDIENCE=
# Tuổi refresh token (giây, 3600..7776000). Trống = 2592000 (30 ngày).
DRIVER_API_REFRESH_TTL_S=
# Mật khẩu chung của các tài xế mẫu app.*@powerme.test (seed-demo.mjs băm scrypt rồi ghi DB).
# >= 12 ký tự, không khoảng trắng/nháy/$/#. Trống = seed bỏ qua đặt mật khẩu (tài xế mẫu không đăng nhập
# được). Sinh bằng: openssl rand -hex 8. KHÔNG dán lên chat nhóm; gửi riêng cho người cần.
# Không truyền vào container csms (chỉ vào lệnh seed). DRIVER_API_DEV_AUTH cố định false trong compose.
DEMO_DRIVER_PASSWORD=

# ---- Đăng nhập dashboard: staff Operator + admin (T128, FE-01a, ADR-0018) ----
# ./init-env.sh tự sinh ba biến này; .env cũ thì chạy ./init-env.sh --add-missing.
# Khoá RIÊNG, khác DRIVER_API_JWT_* (lộ một khoá không mở được bề mặt kia). Cùng luật: đủ cả ba hoặc
# trống cả ba (trống: /api/auth/v1/login trả 503 auth_unavailable, deploy chỉ cảnh báo); thiếu một hoặc
# khoá sai dạng thì CSMS không khởi động nên deploy.sh dừng trước. Khoá: base64 CHUẨN của >= 32 byte
# (openssl rand -base64 32). Đổi khoá/issuer/audience = mọi phiên dashboard phải đăng nhập lại.
DASHBOARD_JWT_SECRET_BASE64=
DASHBOARD_JWT_ISSUER=
DASHBOARD_JWT_AUDIENCE=
# Mật khẩu chung của admin.demo@powerme.test và staff.demo@powerme.test (seed-demo.mjs băm scrypt rồi
# ghi DB). 12..128 ký tự, không khoảng trắng/nháy/$/#. Trống = seed bỏ qua (hai tài khoản đó không đăng
# nhập dashboard được). Sinh bằng: openssl rand -hex 8. KHÔNG dán chat nhóm. Không vào container csms.
DEMO_STAFF_PASSWORD=

# ---- Tuỳ chọn (có mặc định trong docker-compose.yml) ----
# Simulator mặc định nối wss://$DOMAIN/ocpp. Bỏ dấu # ở dòng dưới nếu VPS không tự nối được IP công
# khai của chính nó (hairpin NAT); đường trong mạng compose không qua TLS:
# SIM_CSMS_URL=ws://csms:9000/ocpp
# Ân hạn (giây) sau khi socket đóng trước khi phiên bị coi là orphaned (ADR-0016 D-A; WP1 chốt 120 ngày 26/10)
OFFLINE_GRACE_S=120
OCPP_HEARTBEAT_INTERVAL_SECONDS=300
SESSION_START_TIMEOUT_S=120
SESSION_HARD_CAP_H=24
REPLAY_SKEW_THRESHOLD_S=5
METER_VALUE_SAMPLE_INTERVAL_S=10
# BE-17: RemoteStop timeout -> gửi lại tối đa N lần, cách nhau M giây (hết lượt: để lại dấu vết cho operator)
REMOTE_STOP_RETRY_MAX=3
REMOTE_STOP_RETRY_INTERVAL_S=30
RECONCILE_GAP_FACTOR=3
RECONCILE_ENERGY_TOLERANCE_WH=1

# ---- Chưa dùng (code apps/csms không đọc) — thêm khi module tương ứng có ----
# JWT_SECRET, VNPAY_*, EINVOICE_*, ROUTING_API_KEY, REDIS_URL, HTTP_PORT
# SMART_SEARCH_*: chưa truyền vào compose (Driver API dùng mặc định trong code).
# ALLOW_LEGACY_NO_CREDENTIAL được cố định = false trong docker-compose.yml, không cấu hình ở đây.

# ---- WF-05 onboarding qua console (T119, #111) ----
# Id user admin / operator_staff demo mà route onboarding dùng làm người thao tác. Lấy từ dòng
# "WF-05 console actors: CONSOLE_ACTOR_ADMIN_ID=… CONSOLE_ACTOR_STAFF_ID=…" khi chạy ./deploy.sh <tag> --seed
# hoặc ./seed.sh. Để trống thì hai route onboarding trả 503 actor_not_configured (an toàn).
CONSOLE_ACTOR_ADMIN_ID=
CONSOLE_ACTOR_STAFF_ID=

# ---- VietMap (MB-03) ----
# Khoá API tìm kiếm/chỉ đường phía SERVER cho /places/* và /stations/{id}/route. Secret: không commit,
# không dán chat. Khác khoá tile của app di động. Trống → các route đó trả 503 provider_unavailable.
VIETMAP_SEARCH_API_KEY=
