# Caddy bên trong image dashboard (BE-46): chỉ phục vụ file tĩnh trên :8080, không TLS, không admin
# API. Không proxy gì — API đi qua Caddy chính (infra/staging/Caddyfile).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# Chỉ một origin ngoài: Vietmap (style, tile, font, icon của bản đồ màn 18, FE-03c). Vietmap GL
		# chạy worker từ blob:. API cùng origin; không CDN, không font ngoài.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://maps.vietmap.vn; style-src 'self' 'unsafe-inline'; connect-src 'self' https://maps.vietmap.vn; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}

	# File build có hash trong tên: cache lâu. File thiếu → 404 thật, không trả index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA (react-router): đường không phải file → index.html, không cache.
	handle {
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
