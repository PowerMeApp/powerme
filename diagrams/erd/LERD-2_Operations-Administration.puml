@startuml LERD-2_Operations-Administration
!include _erd_style.iuml
title LERD-2 Logical ERD: Operations & Administration (crow's foot, 3NF)\nPK = identifier · {BK} = business key · (FK) = reference · grey = Should · v0.4 · 27/10/2026 (v0.2 aligned with WP2/WP4 designs, ADR-0016; v0.3 RemoteCommand and CpTimestamp from migration 0001; v0.4 FaultEvent.ResetCommand from migration 0007, FE-04)

entity User {
  * UserId
  --
  Email {BK}
  FullName
  PhoneNumber
  AccountStatus
  CreatedAt
}
entity Driver {
  * UserId (FK)
  --
  ConsentVersion
  ConsentGivenAt
}
entity OperatorStaff {
  * UserId (FK)
  --
  Operator (FK)
  StaffRole
}
entity Admin {
  * UserId (FK)
}
entity Operator {
  * OperatorId
  --
  TaxCode {BK}
  LegalName
  Address
  OperatorStatus
}
entity Site {
  * SiteId
  --
  SiteCode {BK}
  Operator (FK)
  SiteName
  Address
  Latitude
  Longitude
}
entity ChargingPillar {
  * ChargingPillarId
  --
  SerialNumber {BK}
  Site (FK, optional until onboarded)
  Model
  FirmwareVersion
  RatedPowerKw
  Lifecycle
  IsOnline
  LastSeenAt
  AuthPasswordHash
  FreeVendTag
  ReportsSoc
}
entity Connector {
  * ConnectorId
  --
  ChargingPillar (FK) + ConnectorNo {BK}
  ConnectorType
  MaxPowerKw
  ConnectorStatus
  StatusChangedAt
}
entity ConnectorStatusEvent {
  * ConnectorStatusEventId
  --
  Connector (FK) + ReceivedAt {BK}
  Status
  ErrorCode
  VendorErrorCode
  CpTimestamp
  UnexpectedTransition
}
entity RemoteCommand {
  * RemoteCommandId
  --
  ChargingPillar (FK) + RequestedAt {BK}
  ConnectorNo (optional)
  Action
  Payload
  CommandStatus
  RequestedBy (FK, optional)
  IdempotencyKey {U} (optional)
  SentAt (optional)
  RespondedAt (optional)
  Response (optional)
  Error (optional)
}
entity FaultEvent {
  * FaultEventId
  --
  EventNo {BK}
  Connector (FK)
  Source
  ErrorCode
  EventStatus
  RaisedAt
  AcknowledgedBy (FK, optional)
  AcknowledgedAt
  ResolvedAt
  ResetCommand (FK, optional)
}
entity FaultReport {
  * FaultReportId
  --
  ReportNo {BK}
  Driver (FK)
  Connector (FK)
  Description
  ReportedAt
  FaultEvent (FK, optional)
  ClearedAt
  ClearedBy (FK, optional)
}
entity TariffPeriod {
  * TariffPeriodId
  --
  Operator (FK) + Band + TimeRange {BK}
  PricePerKwhVnd
  EffectiveFrom
  EffectiveTo
}
entity Promotion {
  * PromotionId
  --
  PromotionCode {BK}
  Operator (FK)
  DiscountType
  DiscountValue
  ValidFrom
  ValidTo
}
entity MaintenanceTicket <<Should>> {
  * MaintenanceTicketId
  --
  TicketNo {BK}
  FaultEvent (FK)
  AssignedTo (FK)
  TicketStatus
  OpenedAt
  ClosedAt
}
entity PolicyTemplate <<Should>> {
  * PolicyTemplateId
  --
  TemplateCode {BK}
  CreatedBy (FK)
  TemplateType
  Content
}
entity Reservation <<Should>> {
  * ReservationId
  --
  ReservationNo {BK}
  Driver (FK)
  Connector (FK)
  ReservationStatus
  HoldMode
  CreatedAt
  ExpiresAt
}

User <|-- Driver
User <|-- OperatorStaff
User <|-- Admin
Operator ||--o{ OperatorStaff : employs
Operator ||--o{ Site : runs
Site |o--o{ ChargingPillar : hosts
ChargingPillar ||--|{ Connector : has (max 2)
ChargingPillar ||--o{ RemoteCommand : receives
OperatorStaff |o--o{ RemoteCommand : sends (none = CSMS-issued)
Connector ||--o{ ConnectorStatusEvent : records
Connector ||--o{ FaultEvent : is subject of
OperatorStaff |o--o{ FaultEvent : acknowledges
RemoteCommand |o--o{ FaultEvent : resets
Driver ||--o{ FaultReport : submits
Connector ||--o{ FaultReport : is reported in
FaultEvent |o--o{ FaultReport : groups
Operator ||--o{ TariffPeriod : defines
Operator ||--o{ Promotion : offers
FaultEvent ||--o{ MaintenanceTicket : leads to
Admin ||--o{ PolicyTemplate : maintains
Driver ||--o{ Reservation : makes
Connector ||--o{ Reservation : is held by
@enduml