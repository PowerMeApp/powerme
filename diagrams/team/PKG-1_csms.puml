@startuml PKG-1_csms
!include _team.iuml
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 50
title PKG-1 Package diagram: CSMS back end (apps/csms)\n<size:11>26/10/2026 (BM02 F33): arrows between gateway, stations, sessions, reconciliation, console = imports in code; users, billing, tariffs, realtime = target design</size>
footer Content: Ngô Văn Minh Trí (WP2), Package-diagram-CSMS 23/10/2026, dependency rules rewritten from the code 26/10/2026 (docs/PACKAGE-DIAGRAM-CSMS.md §3, §3.1)

package "External to the system" as EXT {
  rectangle "VNPay\nsandbox" as vnp
  rectangle "Charging pillar D1 / YJ-EU\nSAP simulator — WP5" as cp
  rectangle "Driver app\nFlutter — WP3" as app
  rectangle "Operator dashboard\nReact + Vite — WP4" as dash
}
rectangle "Caddy 2\nTLS termination, path-based routing\nADR-0011 — Security Profile 2" as caddy

package "apps/csms — ONE NestJS process, modular monolith (ADR-0002)" as CSMS {
  rectangle "<b>ocpp-gateway</b>\nocpp-rpc 2.2.1 - connection registry\nidentity → socket, epoch\nserialises outgoing CALLs per pillar\nwrites ocpp_message_log BEFORE calling a handler" as gw
  rectangle "<b>stations</b>\ncharge_points - connectors - remote_commands\nonboarding, commands to the pillar (202 + commandId)" as st
  rectangle "<b>sessions</b>\nsessions - meter_values\nidempotency StartTransaction (ADR-0010)\norigin / payment_mode (ADR-0012)" as ses
  rectangle "<b>users</b>\nJWT, roles, RolesGuard\n/api/admin/* in each module" as usr
  rectangle "<b>reconciliation</b>\nreplay - duplicate - meter_gap - orphan_stop\nreconciliation_records, can be switched on/off" as rec
  rectangle "<b>billing — WP5</b>\npricing, invoices, adjustments\nendpoint VNPay IPN" as bil
  rectangle "<b>tariffs — WP5</b>\ntariff schedules" as tar
  rectangle "<b>realtime</b>\nSocket.IO gateway\nonly listens to events, never writes to the DB" as rt
  rectangle "<b>console</b> (Review 2)\nnode:http on 127.0.0.1:3000, no auth yet\nGET /api/admin/*, SSE log; POST disconnect, RemoteStop" as con
}

package "Shared contracts" as SH {
  rectangle "openapi.json\ngenerated by @nestjs/swagger" as oa
  rectangle "packages/shared\nocpp - domain - api/generated - realtime" as pkgs
}

package "Storage" as STORE {
  database "PostgreSQL 16.4\nsource of truth — Drizzle ORM" as pg
  database "Redis 7.4\nSocket.IO adapter - BullMQ" as redis
}

vnp --> caddy : HTTP IPN
cp --> caddy : OCPP-J 1.6 / WSS\n/ocpp/{serialNumber} - Basic Auth
app --> caddy : HTTPS /api/v1\nSocket.IO /realtime
dash --> caddy : HTTPS /api/v1, /api/admin\nSocket.IO /realtime
caddy --> CSMS : HTTP /api/* (planned)\ncontrollers of each module
caddy --> gw : WS :9000 /ocpp/*
caddy --> bil : HTTP\n/api/v1/billing/vnpay/ipn
caddy --> rt : Socket.IO /realtime (planned)

gw --> st : imports StationsModule:\nPillarAuthService (Basic Auth at handshake)
gw --> ses : imports SessionsModule: Authorize / Start /\nMeter / Stop / StatusNotification,\nonStationOffline (after logging)
gw --> rec : imports ReconciliationModule:\nReplayDetector.classify on each frame
con --> gw : ConnectionRegistry:\nclose socket, send RemoteStop
ses --> usr : target: rfid_cards via UsersService\n(today: reads rfid_cards directly)
bil --> ses : reads the meter series via\nSessionsService
ses --> bil : transaction.stopped / amended\n(in-process event)
ses --> rec : imports ReconciliationModule:\nevaluate / record* (direct call);\nsessions then changes sessions.status
bil --> tar : TariffsService
ses ..> rt : transaction.started /\nmeter / stopped
st ..> rt : station.connection,\nconnector.status,\ncommand.result
rec ..> rt : transaction.amended

CSMS --> oa : generated at build time
oa --> app : codegen client Dart
oa --> pkgs : api/generated
pkgs --> dash : shared types

gw --> pg : SQL INSERT\nocpp_message_log\nbefore the handler (ADR-0005)
CSMS --> pg : SQL (Drizzle) — writes only to own tables;\nreads across: console (SELECT), reconciliation\n(credit_transactions), gateway (sessions)
bil --> redis : durable BullMQ jobs with retry
rec --> redis : durable BullMQ jobs with retry
rt --> redis : pub/sub via the Socket.IO\nRedis adapter\n(UI fan-out only, ADR-0006)
@enduml
