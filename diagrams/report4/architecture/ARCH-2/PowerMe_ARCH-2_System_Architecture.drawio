;startFill=1;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1044" y="168" as="sourcePoint"/><mxPoint x="1044" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b1" value="1" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="221.5" y="313.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="221.5" y="513.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="221.5" y="713.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="475.5" y="569.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="665.5" y="569.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="755.5" y="653.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b7" value="7" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="955.5" y="653.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b8" value="8" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1389.5" y="309.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b9" value="9" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1399.5" y="449.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b10" value="10" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1399.5" y="595.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b11" value="11" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1399.5" y="729.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b12" value="12" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="803.5" y="289.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="b13" value="13" style="ellipse;html=1;fillColor=#ED7100;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1033.5" y="289.5" width="21" height="21" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Connections&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;1&lt;/b&gt;&amp;nbsp; Driver App → HTTPS /api/driver/v1 (JWT) · «planned» behind Caddy; GET routes exist on the loopback port (#98)&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;2&lt;/b&gt;&amp;nbsp; Dashboard → HTTPS (static build + /api/admin) · «planned» after users / RolesGuard · SSE planned&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;3&lt;/b&gt;&amp;nbsp; Charge Point → WSS /ocpp/{serialNumber} · OCPP-J 1.6 · Basic Auth (Security Profile 2)&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;4&lt;/b&gt;&amp;nbsp; All public traffic enters on :443 only; TLS ends at Caddy&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;5&lt;/b&gt;&amp;nbsp; Caddy → csms: /ocpp/* → :9000 and /health → :3000 only (compose network); /api/* not proxied yet&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;6&lt;/b&gt;&amp;nbsp; csms → PostgreSQL :5432 via Drizzle ORM · source of truth, append-only ocpp_message_log&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;7&lt;/b&gt;&amp;nbsp; csms → Redis «planned» (BullMQ); today background work polls the DB (D7) · never on the transaction path (ADR-0006)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=11.5;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="885" width="1640" height="195" as="geometry"/></mxCell><mxCell id="legend2" value="&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;8&lt;/b&gt;&amp;nbsp; csms ⇄ VNPay: payment URL out · IPN callback in through Caddy (/billing/vnpay/ipn) · «planned»&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;9&lt;/b&gt;&amp;nbsp; csms → e-invoice provider: invoice data after settlement · «planned»&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;10&lt;/b&gt;&amp;nbsp; csms → FCM → push notifications to the Driver App · «planned»&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;11&lt;/b&gt;&amp;nbsp; csms (Driver API) → Vietmap: place search, route (#98)&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;12&lt;/b&gt;&amp;nbsp; GitHub Actions → VM: deploy.sh over SSH :22 on review-* / v* tags (DB dump to backups/ before migrate)&lt;br&gt;&lt;b style=&#x27;color:#ED7100&#x27;&gt;13&lt;/b&gt;&amp;nbsp; VM pulls tagged images from GHCR (docker compose pull)" style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="850.0" y="891" width="804.0" height="160" as="geometry"/></mxCell><mxCell id="legend3" value="Solid = in the build (GitHub main 0ba20c4) · dashed = «planned» / optional · logos: Devicon, Simple Icons" style="text;html=1;align=right;verticalAlign=top;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="940" y="893" width="714" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>